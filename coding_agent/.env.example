# ============================================================
# Coding Agent 环境变量配置
# 复制此文件为 .env 并填入你的 API Key
# ============================================================

# --- API 配置（必填）---
# DeepSeek: https://platform.deepseek.com/api_keys
# OpenAI:  https://platform.openai.com/api-keys
API_KEY=sk-your-api-key-here

# 模型名称（默认使用 DeepSeek）
MODEL_NAME=deepseek-flash

# API 地址（DeepSeek 兼容 OpenAI 格式）
# OpenAI: https://api.openai.com/v1
BASE_URL=https://api.deepseek.com

# --- 模型参数 ---
# 温度（0-2），越高越有创造性，越低越确定
TEMPERATURE=0.7

# Top-P 采样（0-1），核采样的概率阈值
TOP_P=1.0

# --- 工具调用 ---
# 最大工具调用轮数（防止无限循环）
MAX_TOOL_ROUNDS=8

# 单条命令的默认超时及最长运行时间（秒）
COMMAND_TIMEOUT_SECONDS=60

# --- 上下文管理 ---
# 每次请求的估算 token 总预算，包含消息、工具定义和回复预留
CONTEXT_LIMIT_TOKENS=80000

# --- 流式输出 ---
# 开启后文本响应会实时逐字显示（推荐开启）
STREAMING_ENABLED=true

# --- API 重试 ---
# 最大请求次数（含首次请求）
MAX_RETRIES=3

# 可选：本次进程的模型请求总上限，含重试与降级
# MAX_MODEL_REQUESTS=5

# 重试基础延迟（秒），实际延迟 = base * 2^attempt + 随机抖动
RETRY_BASE_DELAY=1.0
